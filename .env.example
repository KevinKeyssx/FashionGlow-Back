PORT=3000
DATABASE_URL="postgresql://user:password@localhost:5432/fashion_glow_db?schema=public"

# CORS & Seguridad
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
X_SECRET="your_secret_key"

# File Manager
FILE_UPLOAD_LIMIT=5
FILE_MANAGER_URL="https://your-file-manager.com"
FILE_MANAGE_DELETE_ENDPOINT="/delete"
FILE_MANAGE_MULTIPLE_UPLOAD_ENDPOINT="/upload-multiple"
FILE_MANAGE_MULTIPLE_DELETE_ENDPOINT="/delete-multiple"
FILE_MANAGE_MULTIPLE_DELETE_FILES_ENDPOINT="/delete-multiple-files"
FILE_MANAGER_FOLDER="fashion_glow"
FILE_MANAGER_FORMAT="webp"
FILE_MANAGER_QUALITY=80
FILE_MANAGER_MAX_RETRIES=3
FILE_MANAGER_RETRY_DELAY=1000
ALLOW_NEGATIVE_STOCK=true

# Emails (Resend)
EMAIL_FROM="FashionGlow <noreply@yourdomain.com>"
RESEND_API_KEY="re_..."
ADMIN_EMAILS="admin@yourdomain.com"
ABUSE_TO="abuse@yourdomain.com"
